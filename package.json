{
  "name": "vibestack",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Next.js + Express + Supabase blueprint with a vendored Claude Code toolkit and /adapt prune workflow.",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel run start",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rimraf node_modules .next dist"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
